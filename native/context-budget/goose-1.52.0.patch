+/// Select the earliest enabled trigger. A disabled ratio does not disable a fixed limit.
+pub fn trigger_limit(context_limit: usize, ratio: f64, fixed: Option<usize>) -> Option<usize> {
+    let proportional = (context_limit > 0 && ratio.is_finite() && ratio > 0.0 && ratio < 1.0)
+        .then(|| ((context_limit as f64 * ratio).ceil() as usize).max(1));
+    match (proportional, fixed.filter(|n| *n > 0)) {
+        (Some(a), Some(b)) => Some(a.min(b)),
+        (a, b) => a.or(b),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn earliest_trigger_wins() {
+        assert_eq!(trigger_limit(1_000_000, 0.8, Some(30_000)), Some(30_000));
+        assert_eq!(trigger_limit(100_000, 0.2, Some(50_000)), Some(20_000));
+        assert_eq!(trigger_limit(100_000, 0.8, None), Some(80_000));
+        assert_eq!(trigger_limit(0, 0.8, Some(30_000)), Some(30_000));
+        assert_eq!(trigger_limit(100_000, 1.0, Some(30_000)), Some(30_000));
+        assert_eq!(trigger_limit(100_000, 0.0, None), None);
+        assert_eq!(trigger_limit(100_000, f64::NAN, Some(0)), None);
+    }
+}
