+/// Run only in a process with a synthetic GOOSE_PATH_ROOT and explicit budget settings.
+#[tokio::test]
+#[ignore = "requires isolated GOOSE_AUTO_COMPACT_TOKEN_LIMIT/GOOSE_CONTEXT_LIMIT and UAH_TEST_TRIGGER_TOKENS"]
+async fn configured_token_budgets_work_in_both_loops() -> Result<()> {
+    let trigger: i32 = std::env::var("UAH_TEST_TRIGGER_TOKENS")?.parse()?;
+    for machine in [false, true] {
+        for (tokens, expected) in [(trigger - 1, false), (trigger, true)] {
+            let temp = TempDir::new()?;
+            let agent = Agent::new();
+            let session = setup_test_session(
+                &agent,
+                &temp,
+                "budget-both-loops",
+                vec![
+                    Message::user().with_text("old relevant history"),
+                    Message::assistant().with_text("old reply"),
+                ],
+            )
+            .await?;
+            let provider = Arc::new(MockCompactionProvider::new());
+            agent
+                .update_provider(
+                    provider.clone(),
+                    ModelConfig::new("mock-model"),
+                    &session.id,
+                )
+                .await?;
+            agent
+                .config
+                .session_manager
+                .update(&session.id)
+                .usage(Usage::new(Some(tokens), Some(0), Some(tokens)))
+                .apply()
+                .await?;
+            let session_config = SessionConfig {
+                id: session.id.clone(),
+                schedule_id: None,
+                max_turns: Some(3),
+                retry_config: None,
+            };
+            let stream = agent
+                .reply(
+                    Message::user().with_text("hello, retain this current question"),
+                    session_config,
+                    machine,
+                    None,
+                )
+                .await?;
+            tokio::pin!(stream);
+            let mut replaced = false;
+            while let Some(event) = stream.next().await {
+                if matches!(event?, AgentEvent::HistoryReplaced(_)) {
+                    replaced = true;
+                }
+            }
+            assert_eq!(
+                replaced, expected,
+                "state_machine={machine} tokens={tokens}"
+            );
+            assert_eq!(provider.has_compacted.load(Ordering::SeqCst), expected);
+            if expected {
+                let result = agent
+                    .config
+                    .session_manager
+                    .get_session(&session.id, true)
+                    .await?;
+                let conversation = result.conversation.unwrap();
+                assert!(
+                    conversation
+                        .messages()
+                        .iter()
+                        .any(|m| m.as_concat_text().contains("old relevant history")),
+                    "original history must remain stored"
+                );
+                assert!(
+                    conversation
+                        .agent_visible_messages()
+                        .iter()
+                        .any(|m| m.as_concat_text().contains("retain this current question")),
+                    "current question must remain visible to the model"
