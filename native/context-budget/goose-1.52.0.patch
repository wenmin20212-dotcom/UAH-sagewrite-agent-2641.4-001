+pub fn auto_compaction_trigger(context_limit: usize, ratio: f64) -> Option<usize> {
+    let fixed = Config::global()
+        .get_param::<usize>("GOOSE_AUTO_COMPACT_TOKEN_LIMIT")
+        .ok()
+        .filter(|n| *n > 0);
+    budget::trigger_limit(context_limit, ratio, fixed)
