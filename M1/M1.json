                                     },
                                     {
                                         "id":  "M1.sources.006",
                                         "text":  "D:\\SageWrite 当前项目基线"
                                     },
                                     {
                                         "id":  "M1.sources.007",
                                         "text":  "用户关于保留既有 PS1、统一模型调用和 MCP 的明确决定"
                                     },
